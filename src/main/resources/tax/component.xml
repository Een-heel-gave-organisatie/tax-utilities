<component name="tax" type="synapse/template" displayName="Tax Calculations">
    <subComponents>
        <component name="propertyTax">
            <file>propertyTax.xml</file>
            <description>Property Tax calculator that adds 5% to income tax amount</description>
            <displayName>Property Tax</displayName>
        </component>
        <component name="wasteTax">
            <file>wasteTax.xml</file>
            <description>Waste Tax calculator based on income tax threshold (free if >4000, otherwise 100)</description>
            <displayName>Waste Tax</displayName>
        </component>
        <component name="sewerageFee">
            <file>sewerageFee.xml</file>
            <description>Sewerage Fee calculator with fixed value of 50</description>
            <displayName>Sewerage Fee</displayName>
        </component>
    </subComponents>
</component>