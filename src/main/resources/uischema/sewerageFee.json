              "helpTip": "Income tax value as a string (required for consistency, though not used in calculation)"
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Output",
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "targetVariable",
              "displayName": "Output Variable Name",
              "inputType": "string",
              "deriveResponseVariable": true,
              "required": "true",
              "helpTip": "Name of the variable to store the sewerage fee value"
            }
          }
        ]
      }
    }
  ]
